{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TekesUI documented artifact family envelope — proposed profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "color",
    "spacing",
    "radius",
    "stroke",
    "opacity",
    "size",
    "type"
  ],
  "properties": {
    "spacing": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "radius": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "stroke": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "opacity": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "size": {
      "type": "object",
      "required": [
        "tokens"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "required": [
        "tokens",
        "themes"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "value",
              "usage"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "value": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                  },
                  {
                    "type": "object",
                    "required": [
                      "light",
                      "dark",
                      "light-ic",
                      "dark-ic"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "light": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "dark": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "light-ic": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "dark-ic": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      }
                    }
                  }
                ]
              },
              "usage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "themes": {
          "const": [
            "light",
            "dark",
            "light-ic",
            "dark-ic"
          ]
        }
      }
    },
    "type": {
      "type": "object",
      "required": [
        "fonts",
        "families",
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "source",
              "redistribute"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "source": {
                "const": "system"
              },
              "redistribute": {
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "fonts"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "fonts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "styles"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "styles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "family",
                    "fontSize",
                    "fontWeight",
                    "lineHeight",
                    "color"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "family": {
                      "enum": [
                        "ui",
                        "mono"
                      ]
                    },
                    "fontSize": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "fontWeight": {
                      "enum": [
                        400,
                        500,
                        600,
                        700
                      ]
                    },
                    "lineHeight": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "color": {
                      "type": "string",
                      "pattern": "^\\{[a-z][a-z0-9_-]*\\}$"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
