{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "format",
    "instance_format",
    "contract_sha256",
    "definition_source_sha256",
    "source_inputs_sha256",
    "source_inputs_sha256_digest",
    "instances_sha256",
    "surface_rules_sha256",
    "themes"
  ],
  "properties": {
    "format": {"const": "tekesui.theme-artifact-lock/1"},
    "instance_format": {"const": "tekesui.theme-instances/2"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "definition_source_sha256": {"$ref": "#/$defs/sha256"},
    "source_inputs_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "source_inputs_sha256_digest": {"$ref": "#/$defs/sha256"},
    "instances_sha256": {"$ref": "#/$defs/sha256"},
    "surface_rules_sha256": {"$ref": "#/$defs/sha256"},
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "schema_version", "brand_config"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
          "schema_version": {"const": "2.0.0"},
          "brand_config": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
