{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tekesui:design-system:2",
  "title": "TekesUI project DesignSystem entry",
  "description": "Project-owned DesignSystem metadata schema; token values are external and are authoritative JSON build inputs.",
  "type": "object",
  "required": [
    "$schema",
    "format",
    "status",
    "authority",
    "layers",
    "token_source",
    "specs",
    "interaction",
    "themes",
    "accessibility",
    "evidence",
    "known_gaps",
    "theme_system"
  ],
  "properties": {
    "$schema": {
      "const": "./system.schema.json"
    },
    "format": {
      "const": "tekesui-design-system/2"
    },
    "status": {
      "const": "integrated-proposal-with-json-token-authority"
    },
    "authority": {
      "type": "object",
      "required": [
        "historical_visual_baseline_commit",
        "policy",
        "baseline",
        "design_baseline_name",
        "release_tag",
        "change_policy",
        "proposal",
        "gold7"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/projectReference"
        },
        "baseline": {
          "$ref": "#/$defs/projectReference"
        },
        "design_baseline_name": {
          "type": "string"
        },
        "release_tag": {
          "type": "null"
        },
        "change_policy": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/projectReference"
        },
        "gold7": {
          "$ref": "#/$defs/projectReference"
        },
        "historical_visual_baseline_commit": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "object",
      "required": [
        "tokens",
        "layout_and_component_specs",
        "interaction",
        "themes",
        "accessibility",
        "evidence",
        "current_component_capabilities"
      ],
      "properties": {
        "tokens": {
          "$ref": "#/$defs/projectReference"
        },
        "layout_and_component_specs": {
          "$ref": "#/$defs/projectReference"
        },
        "interaction": {
          "$ref": "#/$defs/projectReference"
        },
        "themes": {
          "$ref": "#/$defs/projectReference"
        },
        "accessibility": {
          "$ref": "#/$defs/projectReference"
        },
        "evidence": {
          "$ref": "#/$defs/projectReference"
        },
        "current_component_capabilities": {
          "$ref": "#/$defs/projectReference"
        }
      },
      "additionalProperties": false
    },
    "token_source": {
      "type": "object",
      "required": [
        "document",
        "schema",
        "value_authority",
        "status",
        "unit_policy",
        "format_policy",
        "single_source_migration"
      ],
      "properties": {
        "document": {
          "$ref": "#/$defs/projectReference"
        },
        "schema": {
          "$ref": "#/$defs/projectReference"
        },
        "value_authority": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "unit_policy": {
          "type": "string"
        },
        "format_policy": {
          "type": "string"
        },
        "single_source_migration": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "specs": {
      "type": "object",
      "required": [
        "classification",
        "calibration_layout",
        "typography_policy",
        "radius_derivation",
        "components"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "calibration_layout": {
          "type": "object"
        },
        "typography_policy": {
          "type": "object"
        },
        "radius_derivation": {
          "type": "object"
        },
        "components": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "required": [
        "source",
        "navigation",
        "redraw_policy",
        "static_text_pickers",
        "motion"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/projectReference"
        },
        "navigation": {
          "type": "object"
        },
        "redraw_policy": {
          "type": "array"
        },
        "static_text_pickers": {
          "type": "string"
        },
        "motion": {
          "type": "object"
        },
        "proposal": {
          "$ref": "#/$defs/projectReference"
        },
        "package_source": {
          "$ref": "#/$defs/projectReference"
        }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "accessibility": {
      "type": "object",
      "required": [
        "status",
        "implemented_contracts",
        "not_claimed",
        "policy"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "implemented_contracts": {
          "type": "array"
        },
        "not_claimed": {
          "type": "array"
        },
        "policy": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "manifest",
        "golden_directory",
        "matrix",
        "checker",
        "handoff",
        "golden_policy",
        "limits"
      ],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/projectReference"
        },
        "golden_directory": {
          "$ref": "#/$defs/projectReference"
        },
        "matrix": {
          "type": "string"
        },
        "checker": {
          "$ref": "#/$defs/projectReference"
        },
        "handoff": {
          "$ref": "#/$defs/projectReference"
        },
        "golden_policy": {
          "type": "string"
        },
        "limits": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "theme_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_schema",
        "definitions",
        "internal_modes",
        "surface_rules",
        "surface_rules_schema",
        "generated_instances",
        "generator",
        "normal_build_validator",
        "public_resolver",
        "component_contract",
        "root_concept",
        "legacy_modes_policy",
        "semantic_policy",
        "delivery_status",
        "version_policy",
        "theme_input_contract",
        "reviewed_artifact_lock",
        "artifact_lock_schema"
      ],
      "properties": {
        "theme_schema": {
          "$ref": "#/$defs/projectReference"
        },
        "definitions": {
          "$ref": "#/$defs/projectReference"
        },
        "internal_modes": {
          "$ref": "#/$defs/projectReference"
        },
        "surface_rules": {
          "$ref": "#/$defs/projectReference"
        },
        "surface_rules_schema": {
          "$ref": "#/$defs/projectReference"
        },
        "generated_instances": {
          "$ref": "#/$defs/projectReference"
        },
        "generator": {
          "$ref": "#/$defs/projectReference"
        },
        "normal_build_validator": {
          "$ref": "#/$defs/projectReference"
        },
        "public_resolver": {
          "$ref": "#/$defs/projectReference"
        },
        "component_contract": {
          "$ref": "#/$defs/projectReference"
        },
        "root_concept": {
          "type": "string",
          "minLength": 1
        },
        "legacy_modes_policy": {
          "type": "string",
          "minLength": 1
        },
        "semantic_policy": {
          "type": "string",
          "minLength": 1
        },
        "delivery_status": {
          "type": "string",
          "minLength": 1
        },
        "version_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theme_definition_schema",
            "surface_schema",
            "generation_rules",
            "instance_format",
            "provenance"
          ],
          "properties": {
            "theme_definition_schema": {
              "type": "string",
              "minLength": 1
            },
            "surface_schema": {
              "type": "string",
              "minLength": 1
            },
            "generation_rules": {
              "type": "string",
              "minLength": 1
            },
            "instance_format": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "theme_input_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "definition_schema_version",
            "instance_format",
            "surface_schema_version",
            "rules_version",
            "supported_modes",
            "pinned_inputs",
            "neutral_base_allowed_roles",
            "status_base_allowed_roles",
            "constraints_ref"
          ],
          "properties": {
            "contract_version": {
              "const": "1.0.0"
            },
            "definition_schema_version": {
              "const": "2.0.0"
            },
            "instance_format": {
              "const": "tekesui.theme-instances/2"
            },
            "surface_schema_version": {
              "const": "1.3.0"
            },
            "rules_version": {
              "const": "1.10.0"
            },
            "supported_modes": {
              "const": [
                "light",
                "dark",
                "light-ic",
                "dark-ic"
              ]
            },
            "pinned_inputs": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "neutral_base_allowed_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^p-[a-z0-9-]+$"
              }
            },
            "status_base_allowed_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^p-(status|warning)(-|$)[a-z0-9-]*$"
              }
            },
            "constraints_ref": {
              "const": "design/brand/policy.json"
            }
          }
        },
        "reviewed_artifact_lock": {
          "$ref": "#/$defs/projectReference"
        },
        "artifact_lock_schema": {
          "$ref": "#/$defs/projectReference"
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "projectReference": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
